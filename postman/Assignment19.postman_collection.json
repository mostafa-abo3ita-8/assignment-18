{
  "info": {
    "name": "Assignment 19 - Social Media API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\":\"Mostafa\",\"lastName\":\"Test\",\"email\":\"test@example.com\",\"password\":\"12345678\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"test@example.com\",\"password\":\"12345678\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Toggle Connection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"userId\":\"{{userId}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/toggle-connection",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "toggle-connection"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Posts & Feed",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"My first social media post\",\"location\":\"Egypt\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/post",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "post"
              ]
            }
          }
        },
        {
          "name": "News Feed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/post/news-feed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "post",
                "news-feed"
              ]
            }
          }
        },
        {
          "name": "React to Post",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"type\":\"love\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/post/{{postId}}/reaction",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "post",
                "{{postId}}",
                "reaction"
              ]
            }
          }
        },
        {
          "name": "Soft Delete Post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/post/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "post",
                "{{postId}}"
              ]
            }
          }
        },
        {
          "name": "Hard Delete Post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/post/{{postId}}/hard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "post",
                "{{postId}}",
                "hard"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Create Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"commentText\":\"Nice post!\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/comment/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comment",
                "{{postId}}"
              ]
            }
          }
        },
        {
          "name": "React to Comment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"type\":\"like\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/comment/{{commentId}}/reaction",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comment",
                "{{commentId}}",
                "reaction"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Create/Get Conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"userId\":\"{{userId}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/conversations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "conversations"
              ]
            }
          }
        },
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/conversations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "conversations"
              ]
            }
          }
        },
        {
          "name": "Get Messages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/conversations/{{conversationId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "conversations",
                "{{conversationId}}",
                "messages"
              ]
            }
          }
        }
      ]
    }
  ]
}